# ==============================================================================
# CareerBoost AI - Environment Configuration Guide
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Client-side variables (prefixed with VITE_) are baked into the frontend bundle
# and MUST NEVER contain secret keys (such as service role keys or private AI keys).
# Server-side variables are only accessible in Node.js / Vercel Serverless Functions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Public / Safe for Browser)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Public Anon Key (found in Supabase Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Backend / Admin Configuration (Server-Only, Confidential)
# ------------------------------------------------------------------------------
# Service Role Key for server functions (bypasses RLS for admin user creation / email tokens)
# Found in Supabase Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. AI Model Provider Integration (Server-Only, Optional)
# ------------------------------------------------------------------------------
# Configure a real AI provider (OpenAI, Anthropic, or Google Gemini).
# If unconfigured, CareerBoost AI automatically runs high-quality rule-based simulations
# with transparent disclaimers so all features work reliably without crashing.
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key-here
AI_MODEL_NAME=gpt-4o-mini

# Alternative Gemini:
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. Email Delivery (Server-Only, Optional)
# ------------------------------------------------------------------------------
# Standard SMTP configuration for verification codes and password reset links
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password
SMTP_FROM="CareerBoost AI" <no-reply@careerboost.ai>
MAIL_API_KEY=optional-internal-mailer-secret

# Application Public URL (used for password reset and portfolio sharing links)
APP_URL=http://localhost:5173
PORT=5173
